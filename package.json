{
  "name": "dsh-session-dots",
  "version": "0.1.0",
  "private": true,
  "description": "Configurable sidebar session status dots for DeepSeek Harness: recolour the official dot in place (overlay) or draw your own, with a distinct waiting-for-approval marker.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/nysparia/dsh-session-dots.git" },
  "homepage": "https://github.com/nysparia/dsh-session-dots#readme",
  "bugs": { "url": "https://github.com/nysparia/dsh-session-dots/issues" },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
